# vteam init scaffolds the default agents and refuses to run twice.
mkdir my-app
cd my-app
exec vteam init
stdout 'Created vteam/vteam.config.json \(aven project: my-app\)'
stdout 'Created \.gitignore'
exists vteam/agents/coder/agent.json vteam/agents/improver/AGENT.md vteam/agents/test-writer/MEMORY.md vteam/agent.schema.json
grep '"project": "my-app"' vteam/vteam.config.json
grep '^vteam/\.memory/$' .gitignore

! exec vteam init
stderr 'vteam/ directory already exists'

# The scaffolded agents all load.
exec vteam run
stdout '^  coder  \(worktree, input: task, autoPR\)$'
stdout '^  improver  \(output: task\)$'
stdout '^  security-analyst  \(output: task\)$'
! stdout 'invalid config'

# Crons are opt-in: the agent.json patterns are only defaults until enabled.
exec vteam cron status
stdout 'vteam ▸ cron status'
stdout 'no crons enabled'
! stdout 'merge-ensurer'

exec vteam cron start
stderr 'No crons enabled'

exec vteam cron enable improver
stdout '✓ improver cron enabled 0 \* \* \* \*'
stdout 'not running \(start it with .vteam cron start.\)'
exec vteam cron enable merge-ensurer '*/30 * * * *'
exists vteam/.cron/schedules.json vteam/.cron/.gitignore
exec vteam cron status
stdout 'not running, crons paused'
stdout '• improver +0 \* \* \* \* +next'
stdout '• merge-ensurer +\*/30 \* \* \* \*  next'

! exec vteam cron enable improver 'every hour'
stderr 'invalid cron expression'
! exec vteam cron enable ghost
stderr 'ghost'

exec vteam cron disable improver
stdout '✓ improver cron disabled'
exec vteam cron status
! stdout 'improver'
! exec vteam cron disable improver
stderr 'improver has no cron enabled'

exec vteam --version
stdout 'vteam version'
