{
  "$schema": "../../agent.schema.json",
  "model": "sonnet",
  "cron": "15 */4 * * *",
  "output": "task",
  "allowedTools": [
    "Read",
    "Glob",
    "Grep",
    "Bash(npm audit *)",
    "Bash(npm outdated *)",
    "Bash(npm ls *)",
    "Bash(npm view *)",
    "Bash(pnpm audit *)",
    "Bash(pnpm outdated *)",
    "Bash(yarn audit *)",
    "Bash(yarn outdated *)"
  ],
  "disallowedTools": [
    "Bash(npm audit fix)",
    "Bash(npm audit fix *)",
    "Bash(pnpm audit --fix)",
    "Bash(pnpm audit --fix *)"
  ],
  "memory": {
    "model": "haiku"
  }
}
